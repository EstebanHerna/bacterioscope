# Copy this to .env and fill in values. Never commit .env.
# BacterioScope does not require env vars for core pipeline functionality.
# Uncomment to override defaults:

# BACTERIOSCOPE_MODEL_PATH=data/models/yolov8_disks.pt
# BACTERIOSCOPE_API_HOST=0.0.0.0
# BACTERIOSCOPE_API_PORT=8000
# BACTERIOSCOPE_LOG_LEVEL=INFO

# Persona 2 -- Tavily public-alert search (src/bacterioscope/integrations/tavily.py)
# TAVILY_API_KEY=

# Persona 1 -- Nebius Token Factory agent core (src/bacterioscope/agent/nemotron_client.py)
# Get an API key from your Nebius Token Factory account console (the credit
# promo code from the signup form/email is NOT the API key -- redeem it on
# the console first, then generate a key separately).
# NEBIUS_API_KEY=
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Do not guess these: once NEBIUS_API_KEY is set, run
#   python -c "from bacterioscope.agent import TokenFactoryClient; print(TokenFactoryClient().list_models())"
# and copy the exact Nemotron 3 Nano/Super/Ultra strings from that output.
# NEBIUS_MODEL_NANO=
# NEBIUS_MODEL_SUPER=
# NEBIUS_MODEL_ULTRA=
